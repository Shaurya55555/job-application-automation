{
  "manifest_version": 3,
  "name": "Shaurya Autofill",
  "version": "1.0.0",
  "description": "Fills job application forms and Google Forms with your saved profile.",
  "permissions": [
    "storage",
    "activeTab",
    "unlimitedStorage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Autofill this page"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open autofill popup"
    },
    "fill-page": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Fill the current page immediately"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
